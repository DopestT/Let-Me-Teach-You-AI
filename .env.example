# ---------------------------------------------------------------------------
# Let Me Teach You AI — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets. Every key below is read on the SERVER only,
# except NEXT_PUBLIC_SITE_URL (safe to expose).
# ---------------------------------------------------------------------------

# --- Site ---
# Canonical primary domain. Drives metadata, canonical URLs, and the
# permanent .net -> .com + www redirects.
NEXT_PUBLIC_SITE_URL=https://letmeteachyouai.com
NEXT_PUBLIC_SITE_NAME="Let Me Teach You AI"

# --- OpenAI (server-side only — NEVER exposed to the browser) ---
OPENAI_API_KEY=
# Current OpenAI model. Fully configurable — not hard-coded anywhere in code.
# Set this to whichever current model you have access to (e.g. gpt-5-mini,
# gpt-4o-mini, etc.). Defaults to gpt-5-mini if unset.
OPENAI_MODEL=gpt-5-mini
# Optional org / project scoping
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
# Cost + latency guardrails
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=1

# --- Newsletter provider (Beehiiv) ---
# Provider-agnostic variable names so the provider can change without touching
# the rest of the app. For Beehiiv:
#   NEWSLETTER_API_KEY     = your Beehiiv API key (Settings -> API)
#   NEWSLETTER_AUDIENCE_ID = your Beehiiv Publication ID (pub_xxxxxxxx)
NEWSLETTER_API_KEY=
NEWSLETTER_AUDIENCE_ID=
# Tag applied to prompt-pack signups (used for segmentation / automations).
NEWSLETTER_SIGNUP_TAG=beginner-prompt-pack
# Optional: automation that sends the 5-email welcome sequence + PDF.
NEWSLETTER_WELCOME_AUTOMATION_ID=

# --- Rate limiting (optional; in-memory fallback used if unset) ---
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# --- Contact form (optional inbox for messages) ---
CONTACT_TO_EMAIL=hello@letmeteachyouai.com
