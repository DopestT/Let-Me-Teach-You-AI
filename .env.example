# ---------------------------------------------------------------------------
# Let Me Teach You AI — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets. Every key below is read on the SERVER only,
# except NEXT_PUBLIC_SITE_URL / NEXT_PUBLIC_SITE_NAME / NEXT_PUBLIC_SUBSTACK_URL /
# NEXT_PUBLIC_BUILD_REVIEW_CHECKOUT_URL (safe to expose).
# ---------------------------------------------------------------------------

# --- Site ---
# Canonical primary domain. Drives metadata, canonical URLs, and the
# permanent .net -> .com + www redirects.
NEXT_PUBLIC_SITE_URL=https://letmeteachyouai.com
NEXT_PUBLIC_SITE_NAME="Let Me Teach You AI"
# Optional second distribution surface for AI Ledger. Keep the canonical
# signup/lead-magnet flow on LMTYAI; this only exposes the public Substack link.
NEXT_PUBLIC_SUBSTACK_URL=
# Optional public checkout/payment-link URL for the $29 AI Build Review.
# When blank, the offer page shows a first-access signup instead of a dead button.
NEXT_PUBLIC_BUILD_REVIEW_CHECKOUT_URL=

# --- OpenAI (server-side only — NEVER exposed to the browser) ---
OPENAI_API_KEY=
# Current OpenAI model. Fully configurable — not hard-coded anywhere in code.
# Set this to whichever current model you have access to (e.g. gpt-5-mini,
# gpt-4o-mini, etc.). Defaults to gpt-5-mini if unset.
OPENAI_MODEL=gpt-5-mini
# Optional org / project scoping
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
# Cost + latency guardrails
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=1

# --- Newsletter provider (Brevo) ---
# Provider-agnostic variable names are retained so callers do not change:
#   NEWSLETTER_API_KEY     = Brevo API key (server only)
#   NEWSLETTER_AUDIENCE_ID = dedicated numeric LMTYAI Brevo list ID
# A Brevo automation should trigger when a contact enters that dedicated list.
NEWSLETTER_API_KEY=
NEWSLETTER_AUDIENCE_ID=

# --- Rate limiting (optional; in-memory fallback used if unset) ---
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Durable, shared rate-limit store for the AI endpoint (recommended for prod).
# Without these, tiered limits fall back to per-instance in-memory counting.
# Provision via Vercel Marketplace → Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Per-identifier (IP + anonymous session) ceilings for /api/openai.
AI_RATE_PER_MIN=8
AI_RATE_PER_HOUR=60
AI_RATE_PER_DAY=300

# --- Contact form (optional inbox for messages) ---
CONTACT_TO_EMAIL=hello@letmeteachyouai.com

# --- Supabase subscriber store (every signup is saved here) ---
# Publishable key only; the table is locked by RLS and reached through RPCs.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
